<?xml version="1.0"?>
<ruleset name="DevelopmentTheme">
    <description>WordPress coding standards for the theme.</description>

    <rule ref="WordPress"/>

    <file>./</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/assets/build/*</exclude-pattern>
</ruleset>
